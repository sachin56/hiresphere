APP_NAME=HireSphere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (PostgreSQL / AWS RDS) ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hiresphere
DB_USERNAME=hiresphere_user
DB_PASSWORD=secret

# ─── Session / Cache ─────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=sqs
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail / AWS SES ──────────────────────────────────────────────────────────
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="noreply@hiresphere.io"
MAIL_FROM_NAME="HireSphere"

# ─── AWS Core ────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── AWS S3 (File Storage) ───────────────────────────────────────────────────
AWS_BUCKET=hiresphere-submissions
AWS_RECORDINGS_BUCKET=hiresphere-recordings
AWS_USE_PATH_STYLE_ENDPOINT=false
FILESYSTEM_DISK=s3

# ─── AWS Cognito (Authentication) ────────────────────────────────────────────
AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_COGNITO_CLIENT_SECRET=
AWS_COGNITO_REGION=us-east-1
AWS_COGNITO_JWK_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX/.well-known/jwks.json

# ─── AWS DynamoDB (Messaging) ────────────────────────────────────────────────
DYNAMODB_MESSAGES_TABLE=hiresphere-messages
DYNAMODB_CONVERSATIONS_TABLE=hiresphere-conversations

# ─── AWS SQS (Event Queue) ───────────────────────────────────────────────────
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/123456789
SQS_QUEUE=hiresphere-events
SQS_SUFFIX=
AWS_SQS_REGION=us-east-1

# ─── AWS SNS (Notifications) ─────────────────────────────────────────────────
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:hiresphere-notifications

# ─── Payment (Stripe) ────────────────────────────────────────────────────────
STRIPE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET=sk_test_XXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXX

# ─── WebRTC (Daily.co) ───────────────────────────────────────────────────────
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1

VITE_APP_NAME="${APP_NAME}"
VITE_AWS_REGION="${AWS_DEFAULT_REGION}"
VITE_COGNITO_USER_POOL_ID="${AWS_COGNITO_USER_POOL_ID}"
VITE_COGNITO_CLIENT_ID="${AWS_COGNITO_CLIENT_ID}"
VITE_API_URL="${APP_URL}/api"
